{
  "info": {
    "_postman_id": "a1b2c3d4-5678-90ab-cdef-112233445566",
    "name": "JSONPlaceholder REST API Test Suite",
    "description": "Automated end-to-end REST API functional, schema, performance, and negative test suite built with Postman and Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC01 - GET All Posts (Status 200 & Array Schema)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response time is less than 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});",
              "pm.test('Response returns an array of 100 posts with valid schema', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array').with.lengthOf(100);",
              "    pm.expect(jsonData[0]).to.have.all.keys('userId', 'id', 'title', 'body');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["posts"]
        }
      }
    },
    {
      "name": "TC02 - GET Single Post by ID (Status 200 & Data Match)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Post ID and User ID match expected values', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(1);",
              "    pm.expect(jsonData.userId).to.eql(1);",
              "    pm.expect(jsonData.title).to.be.a('string').and.not.be.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["posts", "1"]
        }
      }
    },
    {
      "name": "TC03 - POST Create New Resource (Status 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Created resource reflects request payload and generates ID', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql('QA Automation API Testing');",
              "    pm.expect(jsonData.body).to.eql('Automated POST request validation using Newman');",
              "    pm.expect(jsonData.userId).to.eql(10);",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"QA Automation API Testing\",\n  \"body\": \"Automated POST request validation using Newman\",\n  \"userId\": 10\n}"
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["posts"]
        }
      }
    },
